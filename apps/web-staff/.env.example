# web-staff (Next.js PWA) — Next đọc env từ thư mục app này (.env.local), KHÔNG đọc
# root .env. Copy → .env.local cho dev: cp apps/web-staff/.env.example apps/web-staff/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001
# web-staff CÓ ô nhập "Mã homestay (tenant)" ở màn login → KHÔNG cần DEFAULT_TENANT_SLUG
# (nhân viên gõ slug, vd "demo", lưu localStorage). Để trống là được.
# Bật nút "Dùng thử nhanh" (Lễ tân / Buồng phòng) ở login. =1 cho local + bản demo.
NEXT_PUBLIC_DEMO_MODE=1
# Sentry error tracking client+server (docs/11 §3). Trống → no-op. Bật ở prod:
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
