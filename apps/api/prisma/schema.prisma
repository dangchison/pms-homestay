generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model pgmigrations {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar(255)
  run_on DateTime @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model subscription_plans {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String    @unique @db.VarChar(32)
  name              String    @db.VarChar(128)
  max_properties    Int
  max_rooms         Int
  max_users         Int
  monthly_price_vnd BigInt
  features          Json      @default("{}")
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  tenants           tenants[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tenants {
  id                     String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                   String                   @unique @db.VarChar(64)
  display_name           String                   @db.VarChar(255)
  business_type          String?                  @db.VarChar(32)
  status                 String                   @default("TRIAL") @db.VarChar(16)
  subscription_plan_id   String?                  @db.Uuid
  trial_ends_at          DateTime?                @db.Timestamptz(6)
  timezone               String                   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  currency               String                   @default("VND") @db.Char(3)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  assets                 assets[]
  bookable_resources     bookable_resources[]
  booking_status_history booking_status_history[]
  bookings               bookings[]
  depreciation_entries   depreciation_entries[]
  document_counters      document_counters[]
  guests                 guests[]
  idempotency_keys       idempotency_keys[]
  invoice_items          invoice_items[]
  invoices               invoices[]
  monthly_meter_readings monthly_meter_readings[]
  operational_expenses   operational_expenses[]
  payment_attempts       payment_attempts[]
  payments               payments[]
  properties             properties[]
  quotes                 quotes[]
  rate_plan_resources    rate_plan_resources[]
  rate_plan_rules        rate_plan_rules[]
  rate_plans             rate_plans[]
  refresh_tokens         refresh_tokens[]
  resource_members       resource_members[]
  room_blocks            room_blocks[]
  room_occupancy         room_occupancy[]
  rooms                  rooms[]
  subscription_plans     subscription_plans?      @relation(fields: [subscription_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  unmatched_payments     unmatched_payments[]
  user_property_roles    user_property_roles[]
  users                  users[]

  @@index([subscription_plan_id], map: "idx_tenants_plan")
  @@index([status], map: "idx_tenants_status")
}

model platform_users {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email              String    @unique(map: "uq_platform_users_email") @db.Citext
  password_hash      String    @db.VarChar(255)
  full_name          String    @db.VarChar(255)
  is_active          Boolean   @default(true)
  two_factor_secret  String?
  two_factor_enabled Boolean   @default(false)
  last_login_at      DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model refresh_tokens {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String           @db.Uuid
  user_id              String           @db.Uuid
  token_hash           String           @db.VarChar(255)
  device_fingerprint   String?          @db.VarChar(255)
  ip_address           String?          @db.Inet
  user_agent           String?
  expires_at           DateTime         @db.Timestamptz(6)
  revoked_at           DateTime?        @db.Timestamptz(6)
  rotated_to           String?          @db.Uuid
  created_at           DateTime         @default(now()) @db.Timestamptz(6)
  refresh_tokens       refresh_tokens?  @relation("refresh_tokensTorefresh_tokens", fields: [rotated_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_refresh_tokens refresh_tokens[] @relation("refresh_tokensTorefresh_tokens")
  tenants              tenants          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users            @relation(fields: [tenant_id, user_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenant_id, user_id], map: "idx_refresh_tokens_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model user_property_roles {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String     @db.Uuid
  user_id     String     @db.Uuid
  property_id String     @db.Uuid
  role        user_role
  permissions Json       @default("{}")
  granted_by  String?    @db.Uuid
  granted_at  DateTime   @default(now()) @db.Timestamptz(6)
  properties  properties @relation(fields: [tenant_id, property_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_upr_property")
  tenants     tenants    @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users      @relation(fields: [tenant_id, user_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, property_id, role])
  @@index([tenant_id, property_id], map: "idx_upr_property")
  @@index([tenant_id, user_id], map: "idx_upr_user")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String                @db.Uuid
  email               String                @db.Citext
  phone               String?               @db.VarChar(20)
  password_hash       String                @db.VarChar(255)
  full_name           String                @db.VarChar(255)
  avatar_url          String?
  default_role        user_role
  is_active           Boolean               @default(true)
  email_verified_at   DateTime?             @db.Timestamptz(6)
  phone_verified_at   DateTime?             @db.Timestamptz(6)
  last_login_at       DateTime?             @db.Timestamptz(6)
  failed_login_count  Int                   @default(0)
  locked_until        DateTime?             @db.Timestamptz(6)
  two_factor_secret   String?
  two_factor_enabled  Boolean               @default(false)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)
  refresh_tokens      refresh_tokens[]
  user_property_roles user_property_roles[]
  tenants             tenants               @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([tenant_id, id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bookable_resources {
  id                  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String                 @db.Uuid
  property_id         String                 @db.Uuid
  type                bookable_resource_type
  name                String                 @db.VarChar(255)
  is_active           Boolean                @default(true)
  created_at          DateTime               @default(now()) @db.Timestamptz(6)
  updated_at          DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?              @db.Timestamptz(6)
  tenants             tenants                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties          properties             @relation(fields: [tenant_id, property_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  bookings            bookings[]
  quotes              quotes[]
  rate_plan_resources rate_plan_resources[]
  resource_members    resource_members[]

  @@unique([tenant_id, id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model properties {
  id                          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                   String                 @db.Uuid
  name                        String                 @db.VarChar(255)
  property_type               property_type
  address_line                String                 @db.VarChar(500)
  ward                        String?                @db.VarChar(100)
  district                    String?                @db.VarChar(100)
  province                    String                 @db.VarChar(100)
  latitude                    Decimal?               @db.Decimal(10, 7)
  longitude                   Decimal?               @db.Decimal(10, 7)
  timezone                    String                 @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  is_rent_to_rent             Boolean                @default(false)
  landlord_name               String?                @db.VarChar(255)
  landlord_phone              String?                @db.VarChar(20)
  rent_to_rent_contract_start DateTime?              @db.Date
  rent_to_rent_contract_end   DateTime?              @db.Date
  monthly_landlord_rent_vnd   BigInt?
  police_business_code        String?                @db.VarChar(50)
  metadata                    Json                   @default("{}")
  created_at                  DateTime               @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime               @default(now()) @db.Timestamptz(6)
  deleted_at                  DateTime?              @db.Timestamptz(6)
  bank_bin                    String?                @db.VarChar(8)
  bank_account_number         String?                @db.VarChar(32)
  bank_account_name           String?                @db.VarChar(255)
  assets                      assets[]
  bookable_resources          bookable_resources[]
  bookings                    bookings[]
  operational_expenses        operational_expenses[]
  tenants                     tenants                @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rate_plans                  rate_plans[]
  rooms                       rooms[]
  user_property_roles         user_property_roles[]

  @@unique([tenant_id, id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resource_members {
  tenant_id          String             @db.Uuid
  resource_id        String             @db.Uuid
  room_id            String             @db.Uuid
  tenants            tenants            @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookable_resources bookable_resources @relation(fields: [tenant_id, resource_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction)
  rooms              rooms              @relation(fields: [tenant_id, room_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)

  @@id([resource_id, room_id])
  @@index([room_id], map: "idx_resource_members_room")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model room_blocks {
