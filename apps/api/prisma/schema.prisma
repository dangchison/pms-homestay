  tenants        tenants          @relation(fields: [tenant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rooms          rooms            @relation(fields: [tenant_id, room_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction)
  room_occupancy room_occupancy[]

  @@unique([tenant_id, id])
  @@index([tenant_id, room_id], map: "idx_room_blocks_room")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
