{
  "name": "@pms/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc-alias -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:sql": "dotenv -e ../../.env -- node-pg-migrate up --migrations-dir ../../infra/migrations-sql --migrations-table pgmigrations --database-url-var DATABASE_URL_MIGRATIONS",
    "db:pull": "dotenv -e ../../.env -- prisma db pull",
    "db:migrate": "pnpm db:migrate:sql && pnpm db:pull && pnpm db:generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@pms/pricing-engine": "workspace:*",
    "@pms/shared-types": "workspace:*",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.0",
    "nestjs-pino": "^4.2.0",
    "nodemailer": "^8.0.11",
    "otplib": "^13.4.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@pms/eslint-config": "workspace:*",
    "@pms/tsconfig": "workspace:*",
    "@swc/core": "^1.10.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.0.0"
  }
}
