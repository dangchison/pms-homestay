# web-admin (Next.js) — Next đọc env từ CHÍNH thư mục app này (.env.local), KHÔNG
# đọc root .env. Copy file này → .env.local cho dev: cp apps/web-admin/.env.example apps/web-admin/.env.local
NEXT_PUBLIC_API_URL=http://localhost:3001
# Login web-admin không có ô nhập tenant → resolve tenant từ subdomain (prod, vd
# demo.pmsapp.vn) hoặc env này khi chạy localhost (1 phần tên miền). Khớp tenant seed demo.
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=demo
