# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug

# ── Database (docs/11 §secrets, ADR-0002) ──────────────────────────────────
# App runtime: app_user (non-superuser — RLS có hiệu lực thật)
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/pms
# Migrations: postgres (owner) — chỉ dùng cho node-pg-migrate / prisma db pull
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/pms

# ── Redis (BullMQ + cache + SSE pub/sub) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Bật cron/worker BullMQ in-process (HOLD expiry…). true ở dev/prod; test set false.
ENABLE_SCHEDULERS=true

# ── Auth (docs/04) ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters!!
JWT_REFRESH_SECRET=dev-only-change-me-too-min-32-chars!!!
# COOKIE_DOMAIN=.pmsapp.vn          # prod; dev để trống (host-only cookie)
APP_WEB_URL=http://localhost:3000

# ── PII field encryption (ADR-0007): "<key_id>:<base64 32 bytes>" ──────────
PII_ENC_KEY_CURRENT=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PII_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Object storage (R2 — ADR-0004; dev có thể trỏ MinIO/local) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pms-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Observability ──────────────────────────────────────────────────────────
# SENTRY_DSN=

# ── Mail (dev: mailpit SMTP 1025, UI http://localhost:8025) ────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Billing-lite SaaS (task 4.7) ───────────────────────────────────────────
# Secret để platform admin xác nhận thanh toán thuê bao (header X-Platform-Secret);
# thiếu → endpoint confirm trả 503. Tài khoản nhận phí nền tảng cho VietQR động.
# PLATFORM_ADMIN_SECRET=dev-only-platform-secret-min-16
PLATFORM_BANK_BIN=970422
PLATFORM_BANK_ACCOUNT=0000000000

# ── Frontend ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
