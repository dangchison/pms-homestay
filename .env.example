# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
LOG_LEVEL=debug
# Ngưỡng (ms) log unit-of-work `withTenant` chậm kèm tenant_id để soi noisy-neighbor
# (docs/18 D2). 0 = tắt (mặc định). Bật ở staging/prod khi điều tra cost theo tenant
# (vd 1000) → tìm log `evt:slow_tenant_tx`.
DB_SLOW_TX_LOG_MS=0

# ── Database (docs/11 §secrets, ADR-0002) ──────────────────────────────────
# App runtime: app_user (non-superuser — RLS có hiệu lực thật).
# Pool (docs/18 D2): connection_limit = pool MỖI instance API; tổng (số instance ×
# limit) PHẢI < Postgres max_connections (trừ phần superuser/migration). pool_timeout(s)
# = thời gian chờ slot trước khi ném lỗi. Gợi ý khởi điểm ~ (core DB × 2) ÷ số instance.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/pms?connection_limit=10&pool_timeout=10
# PROD sau PgBouncer (transaction mode — RLS an toàn vì GUC LOCAL, ADR-0002 §4): trỏ
# DATABASE_URL vào PgBouncer + thêm "?pgbouncer=true" (tắt prepared-statement của Prisma)
# và để connection_limit nhỏ (vd 1) vì PgBouncer mới là pool thật.
# Migrations: postgres (owner) — chỉ dùng cho node-pg-migrate / prisma db pull (đời ngắn)
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:5432/pms

# ── Redis (BullMQ + cache + SSE pub/sub) ───────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# Bật cron/worker BullMQ in-process (HOLD expiry…). true ở dev/prod; test set false.
ENABLE_SCHEDULERS=true

# ── Auth (docs/04) ──────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-only-change-me-min-32-characters!!
JWT_REFRESH_SECRET=dev-only-change-me-too-min-32-chars!!!
# Platform-auth (B4) — secret ký JWT admin nền tảng (platform_users); TÁCH biệt
# JWT_ACCESS_SECRET. Thiếu → /platform/auth/login + confirm thuê bao trả 503.
JWT_PLATFORM_SECRET=dev-only-platform-jwt-secret-min-32-chars!
# COOKIE_DOMAIN=.pmsapp.vn          # prod; dev để trống (host-only cookie)
APP_WEB_URL=http://localhost:3000

# ── PII field encryption (ADR-0007): "<key_id>:<base64 32 bytes>" ──────────
PII_ENC_KEY_CURRENT=k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PII_HMAC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# ── Object storage (R2 — ADR-0004; dev có thể trỏ MinIO/local) ─────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pms-local
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Observability ──────────────────────────────────────────────────────────
# Sentry error tracking (docs/11 §3). Để trống → Sentry no-op (dev/test/local).
# Bật ở staging/prod bằng cách set DSN. Tracing vẫn do OTel đảm nhiệm (§4).
# SENTRY_DSN=
# SENTRY_RELEASE=                 # vd git SHA — gắn version vào event
# Upload source map lúc build (đặt ở CI secrets — KHÔNG commit token):
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# ── Backup → R2 (task 8.1, docs/11 §6 + docs/17 §1) ─────────────────────────
# Dùng bởi infra/scripts/backup-db.sh (host cron) + restore-drill.sh. KHÔNG phải
# env của app (không vào zod env.schema) — script shell đọc trực tiếp.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=pms-backups
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# R2_BUCKET_DR=                     # bucket khác vùng cho copy weekly (tuỳ chọn)
# BACKUP_DATABASE_URL=              # mặc định = DATABASE_URL_MIGRATIONS
# DRILL_DATABASE_URL=               # DB NHÁP cho restore-drill (KHÔNG phải prod)

# ── Mail (dev: mailpit SMTP 1025, UI http://localhost:8025) ────────────────
SMTP_HOST=localhost
SMTP_PORT=1025

# ── Kênh gửi ngoài SMS/ZNS (Đợt 4 — mock/sandbox, KHÔNG cần creds thật) ─────
# mock = MockMessagingProvider (SENT + id mock-<uuid>) — mặc định dev/CI end-to-end.
# log  = LogMessagingProvider (stub cũ, chỉ log, không I/O ngoài).
# esms/zalo = slot creds Phase sau (CHƯA impl — registry ném 'provider chưa cấu hình').
# EMAIL luôn qua SMTP ở trên (SmtpEmailProvider→Mailpit/relay).
SMS_PROVIDER=mock
ZNS_PROVIDER=mock

# ── OCR CCCD/hộ chiếu (Đợt 4/M3 — mock/sandbox, KHÔNG cần creds thật) ───────
# auto = FptOcrProvider (có FPT_AI_API_KEY→gọi FPT.AI; else 503 fallback nhập tay).
# fpt  = luôn FptOcrProvider. mock = MockOcrProvider (tất định từ SHA-256 image_key,
# KHÔNG I/O ngoài) — mock KHÔNG bao giờ tự bật ở prod, chỉ khi set tường minh.
OCR_PROVIDER=auto
# FPT_AI_API_KEY=                    # thật (Phase creds) — auto/fpt gọi FPT.AI khi có
# FPT_AI_ENDPOINT=https://api.fpt.ai/vision/idr/vnm

# ── Billing-lite SaaS (task 4.7) ───────────────────────────────────────────
# @deprecated B4 — thay bằng platform-auth (JWT_PLATFORM_SECRET + đăng nhập
# platform_users qua /platform/auth/login). Không còn bảo vệ endpoint confirm.
# PLATFORM_ADMIN_SECRET=dev-only-platform-secret-min-16
# Tài khoản nhận phí nền tảng cho VietQR động (mặc định dev: MB BIN 970422).
PLATFORM_BANK_BIN=970422
PLATFORM_BANK_ACCOUNT=0000000000
# Cổng thanh toán billing (Đợt 4/M2 — mock/sandbox, KHÔNG cần creds thật).
# manual = luồng hiện hữu (PENDING + QR, admin xác nhận tay). mock = sandbox tự
# confirm (delayed job + endpoint POST /public/billing/mock-gateway/:ref/pay).
BILLING_GATEWAY=manual
MOCK_GATEWAY_AUTOCONFIRM_SECONDS=15

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
# ⚠️ web-admin & web-staff đọc env từ CHÍNH thư mục app (apps/web-*/.env.local),
# KHÔNG đọc root .env này. Cấu hình FE ở: apps/web-admin/.env.example +
# apps/web-staff/.env.example (gồm NEXT_PUBLIC_API_URL + NEXT_PUBLIC_DEFAULT_TENANT_SLUG).
NEXT_PUBLIC_API_URL=http://localhost:3001
