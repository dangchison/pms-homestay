{
  "name": "pms-homestay",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@pms/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml,yaml,css}\"",
    "db:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "db:migrate": "pnpm --filter @pms/api db:migrate",
    "db:generate": "pnpm --filter @pms/api db:generate",
    "db:seed:required": "tsx scripts/seed-prod-required.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "demo:bank-transfer": "tsx scripts/simulate-bank-transfer.ts",
    "db:reset": "docker compose -f infra/docker/docker-compose.dev.yml down -v && pnpm db:up && pnpm db:migrate && pnpm db:seed:required && pnpm db:seed:dev"
  },
  "devDependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "turbo": "^2.3.0",
    "typescript": "^5.8.0",
    "@types/pg": "^8.11.0",
    "@types/node": "^22.10.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "@opentelemetry/propagator-jaeger": "^2.9.0",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "brace-expansion@5": "^5.0.8",
      "fast-uri": "^3.1.4",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  }
}
