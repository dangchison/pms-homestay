# Tài khoản HTTP Basic Auth bảo vệ trang tracking.
# Đặt giá trị THẬT trên Vercel (Settings → Environment Variables), cho CẢ
# Production lẫn Preview — thiếu ở môi trường nào thì môi trường đó trả 401.
# Copy file này thành .env.local để chạy `vercel dev`; .env.local đã bị gitignore.
AUTH_USER=changeme
AUTH_PASS=changeme
